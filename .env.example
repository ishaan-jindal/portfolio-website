# Contact form (required)
# Sent server-side via /api/contact (rate-limited, honeypot-protected)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Admin panel (required for /admin — JWT_SECRET has no fallback)
# ADMIN_PASSWORD_HASH formats:
#   preferred: scrypt:<N>:<r>:<p>:<saltHex>:<keyHex> (salted, memory-hard)
#   legacy:    bare SHA-256 hex digest (unsalted — migrate to scrypt)
# Generate a scrypt hash with:
#   node -e "const c=require('crypto');const s=c.randomBytes(16);c.scrypt(process.argv[1],s,32,{N:16384,r:8,p:1},(e,k)=>console.log(['scrypt','16384','8','1',s.toString('hex'),k.toString('hex')].join(':')))" 'your-password'
ADMIN_PASSWORD_HASH=
JWT_SECRET=
GITHUB_TOKEN=
